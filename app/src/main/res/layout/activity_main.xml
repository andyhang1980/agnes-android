<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agnes AI Studio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="短剧制作工作流"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- ==================== 全局 API 配置 ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 全局 API 配置"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/sp_url"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_custom_url"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:hint="自定义 API 地址"
                    android:textSize="13sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_bg"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone" />

                <!-- 多 Key 轮询 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="API Key (支持多 Key 轮询)"
                        android:textSize="12sp"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/tv_key_stats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="11sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:hint="输入 Key，点击添加"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btn_add_key"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="+ 添加"
                        android:textSize="11sp"
                        android:backgroundTint="#2196F3"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_remove_key"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:text="- 删除当前"
                        android:textSize="11sp"
                        android:backgroundTint="#F44336"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_key_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无 Key"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="4dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== 工作流模型配置 ==================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 工作流模型 (非 Agnes 时可自定义)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文本模型 (剧本/分镜)"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/sp_text_model"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="图片模型 (文生图)"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/sp_image_model"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频模型 (图生视频)"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/sp_video_model"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/spinner_bg" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== 内容输入 ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✏️ 输入短剧主题"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/et_input"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="例如：都市爱情，男女主角在咖啡馆相遇..."
                    android:textSize="13sp"
                    android:padding="10dp"
                    android:background="@drawable/edit_bg"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btn_preset1"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:text="📋 预设主题"
                    android:textSize="12sp"
                    android:backgroundTint="#FF9800"
                    android:textColor="@android:color/white" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== 工作流按钮 ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 工作流"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <!-- 第一步：剧本 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="① "
                        android:textSize="13sp"
                        android:textColor="#E91E63"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_gen_script"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="生成剧本"
                        android:textSize="13sp"
                        android:backgroundTint="#E91E63"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <!-- 第二步：分镜 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="② "
                        android:textSize="13sp"
                        android:textColor="#9C27B0"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_gen_shots"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="生成分镜"
                        android:textSize="13sp"
                        android:backgroundTint="#9C27B0"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <!-- 第三步：文生图 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="③ "
                        android:textSize="13sp"
                        android:textColor="#2196F3"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_gen_image"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="文生图"
                        android:textSize="13sp"
                        android:backgroundTint="#2196F3"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <!-- 第四步：图生视频 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="④ "
                        android:textSize="13sp"
                        android:textColor="#FF5722"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_gen_video"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="图生视频"
                        android:textSize="13sp"
                        android:backgroundTint="#FF5722"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <!-- 一键全流程 -->
                <Button
                    android:id="@+id/btn_generate"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="🚀 一键生成短剧 (全流程)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ==================== 生成结果展示 ==================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 生成结果"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <!-- 图片预览 -->
                <TextView
                    android:id="@+id/tv_image_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼 生成图片"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/preview_bg"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- 视频预览 -->
                <TextView
                    android:id="@+id/tv_video_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎬 生成视频"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <VideoView
                    android:id="@+id/vv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#000000"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <!-- 文本输出 -->
                <TextView
                    android:id="@+id/tv_output_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 文本输出"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/sv_output"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#FAFAFA"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="3dp" />
                </ScrollView>

                <TextView
                    android:id="@+id/tv_empty"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="生成的内容将显示在这里"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
