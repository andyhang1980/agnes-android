<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- 主内容区 -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="0dp">

        <!-- 顶部栏 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agnes AI Studio"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- 工作流主区域 -->
        <ScrollView
            android:id="@+id/sv_workflow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 输入区 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️ 短剧主题"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="6dp" />

                        <EditText
                            android:id="@+id/et_input"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:hint="输入短剧主题..."
                            android:textSize="13sp"
                            android:padding="8dp"
                            android:background="@drawable/edit_bg"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:layout_marginBottom="6dp" />

                        <!-- 高级提示词选择 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <Spinner
                                android:id="@+id/sp_prompt_template"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:background="@drawable/spinner_bg"
                                android:layout_marginEnd="6dp" />

                            <Button
                                android:id="@+id/btn_apply_prompt"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="应用"
                                android:textSize="12sp"
                                android:backgroundTint="#FF9800"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_prompt_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="提示词预览：点击「应用」加载高级提示词"
                            android:textSize="10sp"
                            android:textColor="#999999"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:ellipsize="end" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 工作流步骤 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬 工作流"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="8dp" />

                        <!-- 步骤1：剧本 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/step1_indicator"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="①"
                                android:textSize="12sp"
                                android:textColor="#E91E63"
                                android:textStyle="bold"
                                android:background="@drawable/step_circle"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="剧本生成"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                            <Button
                                android:id="@+id/btn_gen_script"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="生成"
                                android:textSize="11sp"
                                android:backgroundTint="#E91E63"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <!-- 步骤2：分镜 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/step2_indicator"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="②"
                                android:textSize="12sp"
                                android:textColor="#9C27B0"
                                android:textStyle="bold"
                                android:background="@drawable/step_circle"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="分镜生成"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                            <Button
                                android:id="@+id/btn_gen_shots"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="生成"
                                android:textSize="11sp"
                                android:backgroundTint="#9C27B0"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <!-- 步骤3：文生图 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/step3_indicator"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="③"
                                android:textSize="12sp"
                                android:textColor="#2196F3"
                                android:textStyle="bold"
                                android:background="@drawable/step_circle"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="文生图"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                            <Button
                                android:id="@+id/btn_gen_image"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="生成"
                                android:textSize="11sp"
                                android:backgroundTint="#2196F3"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <!-- 步骤4：图生视频 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:id="@+id/step4_indicator"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:gravity="center"
                                android:text="④"
                                android:textSize="12sp"
                                android:textColor="#FF5722"
                                android:textStyle="bold"
                                android:background="@drawable/step_circle"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="图生视频"
                                android:textSize="13sp"
                                android:textColor="#333333" />

                            <Button
                                android:id="@+id/btn_gen_video"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="生成"
                                android:textSize="11sp"
                                android:backgroundTint="#FF5722"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <!-- 一键全流程 -->
                        <Button
                            android:id="@+id/btn_generate"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="🚀 一键生成短剧"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:backgroundTint="#4CAF50"
                            android:textColor="@android:color/white" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 日志输出 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📋 运行日志"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#333333" />

                            <Button
                                android:id="@+id/btn_clear_log"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="清空"
                                android:textSize="10sp"
                                android:backgroundTint="#9E9E9E"
                                android:textColor="@android:color/white" />
                        </LinearLayout>

                        <ScrollView
                            android:id="@+id/sv_log"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="#1A1A2E"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tv_log"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#00FF00"
                                android:fontFamily="monospace"
                                android:textIsSelectable="true"
                                android:lineSpacingExtra="2dp" />
                        </ScrollView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 资产展示 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 生成资产"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:layout_marginBottom="6dp" />

                        <!-- 图片资产 -->
                        <TextView
                            android:id="@+id/tv_image_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖼 图片"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_images"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <!-- 视频资产 -->
                        <TextView
                            android:id="@+id/tv_video_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎬 视频"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_videos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <!-- 文本资产 -->
                        <TextView
                            android:id="@+id/tv_text_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📝 文本"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:visibility="gone" />

                        <ScrollView
                            android:id="@+id/sv_text_assets"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="#FAFAFA"
                            android:padding="8dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_text_assets"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textColor="#333333"
                                android:textIsSelectable="true"
                                android:lineSpacingExtra="2dp" />
                        </ScrollView>

                        <TextView
                            android:id="@+id/tv_empty"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="暂无生成资产"
                            android:textSize="12sp"
                            android:textColor="#AAAAAA" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 侧边栏 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:scrollbars="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@android:drawable/dark_vertical	scrollbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:paddingTop="8dp">

                <!-- ========== 对话/文本 配置 ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="#E91E63"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="对话/文本"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#E91E63" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 地址"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_text_url"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_text_custom_url"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义地址"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Key"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_text_key"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="sk-..."
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_text_model"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_text_custom_model"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义模型名"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="8dp" />

                <!-- ========== 文生图 配置 ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="#2196F3"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="文生图"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2196F3" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 地址"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_image_url"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_image_custom_url"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义地址"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Key"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_image_key"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="sk-..."
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_image_model"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_image_custom_model"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义模型名"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="8dp" />

                <!-- ========== 图生视频 配置 ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="#FF5722"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="图生视频"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FF5722" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 地址"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_video_url"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_video_custom_url"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义地址"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API Key"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_video_key"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="sk-..."
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="模型"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_video_model"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_video_custom_model"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:hint="自定义模型名"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:singleLine="true"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频模式"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <Spinner
                    android:id="@+id/drawer_sp_video_mode"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/spinner_bg"
                    android:layout_marginBottom="2dp" />

                <!-- 首帧 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="首帧图片（可选，保持角色一致）"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:id="@+id/drawer_iv_first_frame"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/edit_bg"
                        android:layout_marginEnd="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drawer_tv_first_frame_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="未选择"
                            android:textSize="10sp"
                            android:textColor="#AAAAAA"
                            android:singleLine="true"
                            android:ellipsize="start" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/drawer_btn_pick_first_frame"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_weight="1"
                                android:text="选择"
                                android:textSize="9sp"
                                android:backgroundTint="#2196F3"
                                android:textColor="@android:color/white"
                                android:layout_marginEnd="3dp" />

                            <Button
                                android:id="@+id/drawer_btn_clear_first_frame"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_weight="1"
                                android:text="清除"
                                android:textSize="9sp"
                                android:backgroundTint="#9E9E9E"
                                android:textColor="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 尾帧 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="尾帧图片（可选）"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:id="@+id/drawer_iv_last_frame"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/edit_bg"
                        android:layout_marginEnd="6dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/drawer_tv_last_frame_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="未选择"
                            android:textSize="10sp"
                            android:textColor="#AAAAAA"
                            android:singleLine="true"
                            android:ellipsize="start" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/drawer_btn_pick_last_frame"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_weight="1"
                                android:text="选择"
                                android:textSize="9sp"
                                android:backgroundTint="#2196F3"
                                android:textColor="@android:color/white"
                                android:layout_marginEnd="3dp" />

                            <Button
                                android:id="@+id/drawer_btn_clear_last_frame"
                                android:layout_width="0dp"
                                android:layout_height="26dp"
                                android:layout_weight="1"
                                android:text="清除"
                                android:textSize="9sp"
                                android:backgroundTint="#9E9E9E"
                                android:textColor="@android:color/white" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0F0F0"
                    android:layout_marginBottom="8dp" />

                <!-- ========== 高级提示词 ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:background="#FF9800"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="高级提示词"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FF9800" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="剧本系统提示词"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_script_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分镜系统提示词"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_shots_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="负面提示词（视频/图片不想要的内容）"
                    android:textSize="10sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="2dp" />

                <EditText
                    android:id="@+id/drawer_et_negative_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="如：模糊, 变形, 水印, 文字"
                    android:textSize="11sp"
                    android:padding="5dp"
                    android:background="@drawable/edit_bg"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:layout_marginBottom="12dp" />

                <!-- 保存按钮 -->
                <Button
                    android:id="@+id/drawer_btn_save_config"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:text="💾 保存全部配置"
                    android:textSize="13sp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
